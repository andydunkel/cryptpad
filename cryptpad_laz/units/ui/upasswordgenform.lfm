object PasswordGenForm: TPasswordGenForm
  Left = 300
  Height = 260
  Top = 200
  Width = 420
  BorderStyle = bsDialog
  Caption = 'Password Generator'
  ClientHeight = 260
  ClientWidth = 420
  OnShow = FormShow
  Position = poScreenCenter
  object LabelLength: TLabel
    Left = 12
    Height = 15
    Top = 16
    Width = 78
    Caption = 'Password length:'
  end
  object SpinLength: TSpinEdit
    Left = 200
    Height = 23
    Top = 12
    Width = 80
    MaxValue = 128
    MinValue = 4
    TabOrder = 0
    Value = 16
  end
  object CheckCapitals: TCheckBox
    Left = 12
    Height = 19
    Top = 48
    Width = 200
    Caption = 'Include capitals'
    Checked = True
    State = cbChecked
    TabOrder = 1
  end
  object CheckNumbers: TCheckBox
    Left = 12
    Height = 19
    Top = 72
    Width = 200
    Caption = 'Include numbers'
    Checked = True
    State = cbChecked
    TabOrder = 2
  end
  object CheckSpecial: TCheckBox
    Left = 12
    Height = 19
    Top = 96
    Width = 200
    Caption = 'Include special characters'
    TabOrder = 3
  end
  object EditResult: TEdit
    Left = 12
    Height = 23
    Top = 132
    Width = 380
    ReadOnly = True
    TabOrder = 4
  end
  object ButtonGenerate: TButton
    Left = 12
    Height = 25
    Top = 168
    Width = 160
    Caption = 'Generate Passwords'
    OnClick = ButtonGenerateClick
    TabOrder = 5
  end
  object ButtonCopy: TButton
    Left = 180
    Height = 25
    Top = 168
    Width = 100
    Caption = 'Copy'
    OnClick = ButtonCopyClick
    TabOrder = 6
  end
  object ButtonClose: TButton
    Left = 320
    Height = 25
    Top = 168
    Width = 75
    Caption = 'OK'
    Default = True
    ModalResult = 1
    TabOrder = 7
  end
end
